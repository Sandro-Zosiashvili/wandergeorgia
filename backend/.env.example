# ─────────────────────────────────────────────────────────────
# WanderGeorgia backend — environment variables
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────

# The Gmail address the emails are SENT FROM (the "postman").
MAIL_USER=wandergeorgia.booking@gmail.com

# 16-character Gmail App Password (NOT the normal password).
# Get it at: https://myaccount.google.com/apppasswords
# Paste it without spaces, e.g. abcdefghijklmnop
MAIL_APP_PASSWORD=

# Where booking requests should land (the admin inbox).
# Can be the same as MAIL_USER.
ADMIN_EMAIL=wandergeorgia.booking@gmail.com

# Which frontend origin is allowed to call this API (CORS).
# Local dev Next.js runs on http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# Port the backend listens on.
PORT=4000
